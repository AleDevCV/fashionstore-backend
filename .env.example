# =============================================================================
# FASHIONSTORE - VARIABLES DE ENTORNO (LOCAL / DOCKER)
# Este archivo está en .gitignore: NO se sube al repositorio.
# =============================================================================

# --- Conexión a PostgreSQL -----------------------------------------------
# DB_HOST=localhost sirve para correr uvicorn directamente en Windows.
# Dentro de docker-compose, el servicio "api" sobrescribe este valor a "db".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fashionstore
DB_USER=postgres
DB_PASSWORD=cambiar_esta_clave

# --- Puertos publicados hacia Windows ------------------------------------
# Cambiar si ya tienes un PostgreSQL local ocupando el 5432.
DB_PORT_HOST=5432
API_PORT_HOST=8000

# --- Tamaño del pool de conexiones ---------------------------------------
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# --- Orígenes permitidos por CORS (Angular y Flutter), separados por comas -
ALLOWED_ORIGINS=*

# --- Seguridad JWT (CU01) -------------------------------------------------
# SECRET_KEY firma los tokens: si cambia, TODAS las sesiones activas se invalidan.
# En el despliegue de nube debe generarse una distinta y jamas versionarse.
# Para generar otra:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generar_una_clave_con_secrets_token_urlsafe
JWT_ALGORITHM=HS256
# Vigencia del token en minutos (480 = 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Notificaciones y Recuperación por Correo (CU04) -----------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fashionstore.com
SMTP_USE_TLS=false
FRONTEND_URL=http://localhost:4200
